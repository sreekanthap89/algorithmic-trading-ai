# Sample .env file for Trading App configuration
# Copy to .env and customize for your environment

# Data Sources
DATA_CACHE_DIR=data
DATA_CACHE_DAYS=7

# Model Training
MODEL_RETRAIN_FREQUENCY=7d
AUTO_ARCHIVE_MODELS=true
MAX_VERSIONS_PER_MODEL=5

# Backtesting
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_COMMISSION=0.001
BACKTEST_SLIPPAGE=0.0005

# Logging
LOG_LEVEL=INFO
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# API Settings
YFINANCE_TIMEOUT=30
YFINANCE_MAX_RETRIES=3

# Feature Engineering
MIN_DATA_POINTS=50
TARGET_DEFINITION=next_close_higher

# Model Ensemble Weights
ENSEMBLE_ML_WEIGHT=0.45
ENSEMBLE_QUANTUM_WEIGHT=0.25
ENSEMBLE_QUANTILE_WEIGHT=0.15
ENSEMBLE_MARKOV_WEIGHT=0.15

# Trading Signals
BUY_THRESHOLD=0.56
SELL_THRESHOLD=0.44
NEUTRAL_MIN=0.44
NEUTRAL_MAX=0.56

# Portfolio Settings
INITIAL_CASH=100000
MAX_POSITION_SIZE=0.1
RISK_PER_TRADE=0.02
